# 文件：.env.example
# 作用：环境变量模板。`make env` 会把它复制成 .env（.env 不进仓库）。
# 最少要改的：OPENAI_API_KEY。其余默认值适合本地演示，对外开放前要换成随机的密码和密钥。

# Copy to .env (make env does this). .env is git-ignored; keep real secrets only there.
# Host ports use each component's usual default. Change them here if a port is taken.

# --- Postgres (container settings and the URL the apps use) ---
POSTGRES_USER=starit
POSTGRES_PASSWORD=starit
POSTGRES_DB=starit
STARIT_PG_PORT=5432

# --- Redis ---
STARIT_REDIS_PORT=6379

# --- Object storage (S3 API, MinIO-compatible image) ---
MINIO_ROOT_USER=starit
MINIO_ROOT_PASSWORD=starit-secret
STARIT_S3_PORT=9000
STARIT_S3_CONSOLE_PORT=9001

# --- Keycloak (identity provider; demo realm is imported on first start) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
STARIT_KEYCLOAK_PORT=8080

# --- API ---
STARIT_API_PORT=8000
# Browser origins allowed to call the API (comma separated).
STARIT_CORS_ORIGINS=http://localhost:3000

# --- Optional observability (make up-obs): Grafana http://localhost:3300 (admin / admin) ---
STARIT_GRAFANA_PORT=3300
STARIT_PROMETHEUS_PORT=9090
STARIT_TEMPO_PORT=3200
STARIT_OTLP_PORT=4318
STARIT_LANGFUSE_PORT=3100  # make up-langfuse: http://localhost:3100 (admin@starit.example / starit-local)
# Add prompts and answers to spans (off by default: they contain what people asked).
STARIT_OTEL_CAPTURE_CONTENT=false

# --- Web front end ---
STARIT_WEB_PORT=3000

# --- Settings read by the Python apps when run on the host (uv run ...) ---
STARIT_ENV=dev
STARIT_LOG_LEVEL=INFO
# The app connects as ai_app (created by the migrations); migrations connect as the owner.
STARIT_APP_DB_PASSWORD=starit-app
STARIT_DATABASE_URL=postgresql+psycopg://ai_app:starit-app@localhost:5432/starit
STARIT_MIGRATION_DATABASE_URL=postgresql+psycopg://starit:starit@localhost:5432/starit
STARIT_REDIS_URL=redis://localhost:6379/0
STARIT_S3_ENDPOINT_URL=http://localhost:9000
STARIT_S3_ACCESS_KEY=starit
STARIT_S3_SECRET_KEY=starit-secret
STARIT_S3_BUCKET=starit-documents
# Tokens carry the localhost issuer; keys are fetched from the same Keycloak.
STARIT_OIDC_ISSUER=http://localhost:8080/realms/starit
STARIT_OIDC_JWKS_URL=http://localhost:8080/realms/starit/protocol/openid-connect/certs
STARIT_OIDC_AUDIENCE_API=starit-api
STARIT_OIDC_AUDIENCE_MCP=starit-mcp

# --- Data access (MCP server) ---
STARIT_MCP_PORT=8100
STARIT_MCP_URL=http://localhost:8100/mcp
# "mcp": the API calls the MCP server with the user's token; "local": same tools in-process.
STARIT_DATA_TOOLS_BACKEND=local

# --- Embeddings (change the model here; re-ingest the documents after a change) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- LLM keys (OPENAI_API_KEY is needed from milestone M3 on) ---
# In Compose only the litellm service receives these; api, worker and mcp-server call models
# through it (STARIT_LLM_GATEWAY=litellm_proxy). Run on the host (uv run), the keys are used
# directly (STARIT_LLM_GATEWAY=litellm_lib, the default).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# The gateway's own key, used between services. Change it if the port is reachable by others.
LITELLM_MASTER_KEY=sk-starit-local-dev
STARIT_LITELLM_PORT=4100
# Models tried in this order when a chat call errors (after the model each step asks for).
STARIT_LLM_FALLBACKS=openai/gpt-4o-mini,anthropic/claude-haiku-5-5

# --- Limits on the chat endpoint: user, address, and the day's spend ---
STARIT_RATE_LIMIT_CHAT_PER_MINUTE=20
STARIT_RATE_LIMIT_IP_PER_MINUTE=60
# Networks whose X-Forwarded-For is believed (your reverse proxy). Empty: use the connection's
# address. In local Docker every browser shows up as the Docker gateway, so this limit is then
# really "the whole machine per minute".
STARIT_TRUSTED_PROXIES=
# What api, worker and mcp-server may spend on models per UTC day, together. 0 switches it off.
STARIT_DAILY_BUDGET_USD=0.5

# --- Business mode (optional; the default "standalone" keeps everything as before) ---
# In business mode the assistant belongs to the business module: the token only says who you are (its realm is a
# company's realm), the roles, permissions and data scopes come from the business module's internal interface,
# structured questions read the business database through read-only views, and the knowledge base is separated
# by company. Start the business module with INTERNAL_API_KEY set to the same value as the key below.
# STARIT_IDENTITY_MODE=business
# STARIT_OIDC_TENANT_ISSUER_BASE=http://localhost:8180/realms
# STARIT_OIDC_TENANT_REALM_PREFIX=tenant-
# STARIT_BUSINESS_API_URL=http://{code}.localhost:4000
# STARIT_BUSINESS_INTERNAL_KEY=change-me
# STARIT_BUSINESS_DATABASE_URL=postgresql+psycopg://ai_reader:starit-ai-biz@localhost:5433/starit_biz
# STARIT_BUSINESS_CAMPUS_ALIASES=HQ:BJ
# One origin per company, because the browser only allows listed origins:
# STARIT_CORS_ORIGINS=http://hq.localhost:3000,http://riverside-franchise.localhost:3000
# Sync course syllabi and material lists from the business module (needs `make biz-up-kafka` there):
# STARIT_KAFKA_BROKERS=localhost:9094
# Web: choose a company's realm from the address (hq.localhost:3000 -> realm tenant-hq, client "ai"). Build-time values:
# NEXT_PUBLIC_TENANT_REALM_BASE=http://localhost:8180/realms
