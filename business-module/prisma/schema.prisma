// 业务模块数据模型（B1：租户、账号、人员、组织、角色、菜单、入口的基础表）。
//
// 约定（11 号文档第 9 节）：
//   - 每张业务表有 tenant_id；平台提供的行（角色模板、平台菜单、入口）tenant_id 为空，租户只读。
//   - 主键 uuid；基础字段 created_at / updated_at / created_by / updated_by；业务删除用 deleted_at 软删除。
//   - 行级安全（RLS）在迁移 SQL 里启用；应用用低权限账号 biz_app 连库，迁移用库所有者账号。
//   - 部门祖先链 ancestors 是 text[]（含自己）+ GIN 索引，由数据库触发器维护。
generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

enum TenantStatus {
  provisioning // 正在开通（失败可重试）
  active // 正常
  notified // 已通知待停用
  suspended // 已停用：登录被拒，数据保留

  @@map("tenant_status")
}

enum TenantType {
  direct // 直营
  franchise // 加盟（仅标注）

  @@map("tenant_type")
}

enum AccountStatus {
  pending // 待激活：已发邀请、未设密码
  active
  locked
  disabled

  @@map("account_status")
}

enum CampusType {
  hq // 总部（不能关闭）
  campus

  @@map("campus_type")
}

enum CampusStatus {
  normal
  stop_new // 停止新增（过渡期）
  closed

  @@map("campus_status")
}

enum RoleKind {
  custom // 租户自建或平台模板
  tenant_admin // 内置：租户管理员
  student // 内置：学生

  @@map("role_kind")
}

enum MenuType {
  directory
  menu
  button
  link

  @@map("menu_type")
}

enum PersonType {
  staff
  student

  @@map("person_type")
}

/// 数据权限集的种类。内置五种由平台提供（tenant_id 为空），custom 是租户在组织树上勾选的。
enum ScopeKind {
  all // 全部
  own_dept // 本部门
  own_dept_tree // 本部门及以下
  self // 仅本人
  own_classes // 本人任教/就读的班级
  custom // 自定义：组织树上勾选的节点，可含下级

  @@map("scope_kind")
}

enum StaffStatus {
  active // 在职
  on_leave // 停薪留职
  left // 离职

  @@map("staff_status")
}

enum StudentStatus {
  enrolled // 在读
  on_leave // 休学
  graduated // 毕业
  withdrawn // 退学
  completed // 结业

  @@map("student_status")
}

enum TermStatus {
  planned // 计划中
  enrolling // 选课中
  in_progress // 进行中
  ended // 已结束

  @@map("term_status")
}

enum SectionStatus {
  draft // 草稿：学生不可见
  open // 开放选课
  in_progress // 进行中
  ended // 已结课：成绩锁定
  cancelled // 已取消

  @@map("section_status")
}

enum EnrollmentStatus {
  enrolled // 已选
  voided // 作废（截止日前退课、班级取消）：不出现在成绩单上
  withdrawn // 退课（W）：截止日之后退课，保留并出现在成绩单上，不计 GPA
  completed // 已完成：学期结束，由成绩模块写入最终成绩

  @@map("enrollment_status")
}

enum SubmissionStatus {
  submitted // 已提交
  grading // 批改中（已有部分打分，未发布）
  published // 已发布：学生可见得分

  @@map("submission_status")
}

enum LoginResult {
  success
  denied

  @@map("login_result")
}

model Tenant {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String       @unique // 登录网址的第一段，开通后不可修改（数据库触发器保证）
  name             String
  shortName        String?      @map("short_name")
  type             TenantType   @default(direct)
  status           TenantStatus @default(provisioning)
  /// 开通进度，每一步完成后记录，重试时从断点继续
  provisionStep    String       @default("created") @map("provision_step")
  timezone         String       @default("UTC")
  contactName      String?      @map("contact_name")
  contactEmail     String?      @map("contact_email")
  plannedSuspendAt DateTime?    @map("planned_suspend_at")
  noticeText       String?      @map("notice_text")
  contactPhone     String?      @map("contact_phone")
  remark           String?
  notifiedAt       DateTime?    @map("notified_at")
  /// 配额：账号数、存储（MB）上限，空 = 不限（B15）
  maxAccounts      Int?         @map("max_accounts")
  maxStorageMb     Int?         @map("max_storage_mb")
  suspendedAt      DateTime?    @map("suspended_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")

  menuGrants TenantMenuGrant[]
  accounts   Account[]
  persons    Person[]
  roles      Role[]
  accountRoles AccountRole[]
  menus      Menu[]
  entryMenus EntryMenu[]
  depts      Dept[]
  campuses   Campus[]
  posts      Post[]
  roleMenus      RoleMenu[]
  dataScopeSets  DataScopeSet[]
  dataScopeNodes DataScopeSetNode[]
  roleDataScopes RoleDataScope[]
  personDepts    PersonDept[]
  staffProfiles  StaffProfile[]
  studentProfiles StudentProfile[]
  emergencyContacts EmergencyContact[]
  loginLogs      LoginLog[]
  auditLogs      AuditLog[]
  dictTypes      DictType[]
  dictItems      DictItem[]
  sysParams      SysParam[]
  operationLogs  OperationLog[]
  terms          Term[]
  majors         Major[]
  courses        Course[]
  sections       Section[]
  outboxEvents   OutboxEvent[]

  @@map("tenant")
}

/// 租户功能授权：平台管理员对某个租户开通的菜单/按钮
model TenantMenuGrant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  menuId    String   @map("menu_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  menu   Menu   @relation(fields: [menuId], references: [id])

  @@unique([tenantId, menuId])
  @@map("tenant_menu_grant")
}

model Person {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  type       PersonType
  fullName   String     @map("full_name")
  workEmail  String?    @map("work_email")
  /// 敏感信息（hr:person:sensitive）：出生日期、性别、证件号、个人电话、住址
  birthDate  DateTime?  @map("birth_date") @db.Date
  gender     String?
  idNumber   String?    @map("id_number")
  phone      String?
  address    String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at")
  createdBy  String?    @map("created_by") @db.Uuid
  updatedBy  String?    @map("updated_by") @db.Uuid
  deletedAt  DateTime?  @map("deleted_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  account Account?
  depts   PersonDept[]
  staff   StaffProfile?
  student StudentProfile?
  emergencyContacts EmergencyContact[]

  @@index([tenantId])
  @@map("person")
}

model Account {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  /// 租户内唯一
  username       String
  /// 可选，租户内唯一
  email          String?
  /// 与人员 1:1；内置租户管理员、服务账号没有人员
  personId       String?       @unique @map("person_id") @db.Uuid
  keycloakUserId String?       @unique @map("keycloak_user_id")
  status         AccountStatus @default(pending)
  isBuiltinAdmin Boolean       @default(false) @map("is_builtin_admin")
  isService      Boolean       @default(false) @map("is_service")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  deletedAt      DateTime?     @map("deleted_at")
  /// 通知和邮件的语言（en / zh）；空 = 跟随请求语言，邮件默认 en
  locale         String?

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  person Person?       @relation(fields: [personId], references: [id])
  roles  AccountRole[]

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@map("account")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 为空 = 平台角色模板，开通租户时复制给租户
  tenantId    String?   @map("tenant_id") @db.Uuid
  code        String
  name        String
  kind        RoleKind  @default(custom)
  isTemplate  Boolean   @default(false) @map("is_template")
  /// 租户的角色由哪个模板复制而来
  templateId  String?   @map("template_id") @db.Uuid
  sort        Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  tenant   Tenant?       @relation(fields: [tenantId], references: [id])
  template Role?         @relation("RoleTemplate", fields: [templateId], references: [id])
  copies   Role[]        @relation("RoleTemplate")
  accounts AccountRole[]
  menus    RoleMenu[]
  scopes   RoleDataScope[]

  @@unique([tenantId, code])
  @@map("role")
}

model AccountRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([accountId, roleId])
  @@map("account_role")
}

model Menu {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 为空 = 平台提供（租户只读）
  tenantId    String?   @map("tenant_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  /// 翻译键，界面按语言取文字（Q4）；租户自建菜单直接存名称
  nameKey     String?   @map("name_key")
  name        String
  type        MenuType
  route       String?
  /// 页面组件路径：构建时打包的页面，租户不能新增
  component   String?
  /// 平台提供的菜单的稳定标识（菜单目录同步用），如 system:role；租户自建菜单为空
  code        String?
  /// 权限标识，如 system:user:add
  perms       String?
  icon        String?
  sort        Int       @default(0)
  visible     Boolean   @default(true)
  status      Boolean   @default(true)
  /// 学生门户菜单适用的学籍状态（逗号分隔，默认在读）
  applicableStatuses String? @map("applicable_statuses")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  tenant   Tenant?           @relation(fields: [tenantId], references: [id])
  parent   Menu?             @relation("MenuTree", fields: [parentId], references: [id])
  children Menu[]            @relation("MenuTree")
  grants   TenantMenuGrant[]
  entries  EntryMenu[]
  roles    RoleMenu[]
  platformRoles PlatformRoleMenu[]

  @@index([tenantId])
  @@index([parentId])
  @@map("menu")
}

/// 入口：管理后台 / 学生门户 / 平台。固定，由平台提供，租户不能新建。
model Entry {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String

  menus EntryMenu[]

  @@map("entry")
}

/// 入口管理：把顶层菜单分配给入口。平台分配的行 tenant_id 为空（租户只读）。
model EntryMenu {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  entryId  String  @map("entry_id") @db.Uuid
  menuId   String  @map("menu_id") @db.Uuid
  sort     Int     @default(0)

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  entry  Entry   @relation(fields: [entryId], references: [id])
  menu   Menu    @relation(fields: [menuId], references: [id])

  @@unique([entryId, menuId, tenantId])
  @@map("entry_menu")
}

/// 部门树。ancestors 含自己，由触发器维护；"本部门及以下" = ancestors @> ARRAY[部门id]
model Dept {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String
  sort      Int       @default(0)
  status    Boolean   @default(true)
  ancestors String[]  @default([])
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  parent   Dept?   @relation("DeptTree", fields: [parentId], references: [id])
  children Dept[]  @relation("DeptTree")
  campus   Campus?

  @@index([tenantId])
  @@index([parentId])
  @@index([ancestors], type: Gin)
  @@map("dept")
}

/// 校区 = 部门树上的一个根节点；总部也是一个校区。
model Campus {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  deptId    String       @unique @map("dept_id") @db.Uuid
  code      String
  name      String
  shortName String?      @map("short_name")
  address   String?
  timezone  String       @default("UTC")
  type      CampusType   @default(campus)
  status    CampusStatus @default(normal)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  updatedBy String?      @map("updated_by") @db.Uuid
  deletedAt DateTime?    @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  dept   Dept   @relation(fields: [deptId], references: [id])
  sections Section[]

  @@unique([tenantId, code])
  @@map("campus")
}

model Post {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  sort      Int       @default(0)
  status    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("post")
}

/// 角色勾选的菜单/按钮（操作权限）。角色模板的行 tenant_id 为空。
model RoleMenu {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  menuId    String   @map("menu_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  menu   Menu    @relation(fields: [menuId], references: [id])

  @@unique([roleId, menuId])
  @@index([tenantId])
  @@map("role_menu")
}

/// 数据权限集。内置五种（tenant_id 为空）+ 租户自定义。
model DataScopeSet {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  code      String
  name      String
  kind      ScopeKind
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant?            @relation(fields: [tenantId], references: [id])
  nodes  DataScopeSetNode[]
  roles  RoleDataScope[]

  @@unique([tenantId, code])
  @@map("data_scope_set")
}

/// 自定义数据权限集在组织树上勾选的节点（校区也是部门树上的节点）
model DataScopeSetNode {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  setId           String   @map("set_id") @db.Uuid
  deptId          String   @map("dept_id") @db.Uuid
  includeChildren Boolean  @default(true) @map("include_children")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  set    DataScopeSet @relation(fields: [setId], references: [id])

  @@unique([setId, deptId])
  @@map("data_scope_set_node")
}

/// 角色拥有的数据权限集（多个取并集）。角色模板的行 tenant_id 为空。
model RoleDataScope {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  setId     String   @map("set_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant?      @relation(fields: [tenantId], references: [id])
  role   Role         @relation(fields: [roleId], references: [id])
  set    DataScopeSet @relation(fields: [setId], references: [id])

  @@unique([roleId, setId])
  @@index([tenantId])
  @@map("role_data_scope")
}

/// 任职记录：人员在部门里的任职（教职员工）或在组织树上的归属（学生）。一人多条，调岗不改旧记录，
/// 新增一条并给旧记录填结束日期，保留历史。"当前有效" = 开始日期 <= 今天 且（没有结束日期 或 结束日期 >= 今天）。
model PersonDept {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  personId  String    @map("person_id") @db.Uuid
  deptId    String    @map("dept_id") @db.Uuid
  postId    String?   @map("post_id") @db.Uuid
  isPrimary Boolean   @default(false) @map("is_primary")
  /// staff = 教职员工任职；student = 学生在组织树上的归属
  kind      String    @default("staff")
  startDate DateTime  @default(dbgenerated("CURRENT_DATE")) @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId, deptId])
  @@index([personId])
  @@map("person_dept")
}

/// 员工档案（一人一份）
model StaffProfile {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  personId           String      @unique @map("person_id") @db.Uuid
  employeeNo         String      @map("employee_no")
  hireDate           DateTime    @map("hire_date") @db.Date
  status             StaffStatus @default(active)
  employmentType     String      @default("full_time") @map("employment_type")
  /// 离职/停薪留职的生效日期：到点由定时任务切换；今天或更早的立即生效
  pendingStatus      StaffStatus? @map("pending_status")
  pendingEffectiveOn DateTime?   @map("pending_effective_on") @db.Date
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at")
  createdBy          String?     @map("created_by") @db.Uuid
  updatedBy          String?     @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@unique([tenantId, employeeNo])
  @@map("staff_profile")
}

/// 学员档案（一人一份）。专业申报在教学模块（B6）里。
model StudentProfile {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  personId       String        @unique @map("person_id") @db.Uuid
  studentNo      String        @map("student_no")
  /// 所属校区（学员在档案里直接选）
  campusId       String        @map("campus_id") @db.Uuid
  enrollTerm     String?       @map("enroll_term")
  academicStatus StudentStatus @default(enrolled) @map("academic_status")
  degreeType     String?       @map("degree_type")
  /// 方向/专业的文字（B6 有专业表之前先记文字，例如样例里的 java / python / typescript）
  program        String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@unique([tenantId, studentNo])
  @@index([tenantId, campusId])
  @@map("student_profile")
}

/// 紧急联系人：挂在自然人上，员工和学员共用；敏感信息，查看和修改都写日志
model EmergencyContact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  personId     String   @map("person_id") @db.Uuid
  priority     Int      @default(1)
  name         String
  relationship String
  phone        String
  phone2       String?
  email        String?
  address      String?
  postalCode   String?  @map("postal_code")
  isGuardian   Boolean  @default(false) @map("is_guardian")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId, personId])
  @@map("emergency_contact")
}

/// 登录日志：进入某个入口的成功/被拒记录（认证本身在 Keycloak，这里记业务侧的入口资格检查）
model LoginLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  accountId String?     @map("account_id") @db.Uuid
  username  String?
  entry     String
  result    LoginResult
  reason    String?
  ip        String?
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("login_log")
}

/// 操作日志：权限变更、角色分配等敏感写操作
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  detail         Json?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// 平台域（B3）：平台账号、平台角色、平台日志、定时任务。不属于任何租户，没有 tenant_id，
// 只有"平台入口"的请求（主机名 platform.*、平台域令牌）才会读写，用平台专用的数据库连接。
// ---------------------------------------------------------------------------

/// 平台账号（运营 SaaS 的人），在 Keycloak 的 platform 域里认证
model PlatformAccount {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username       String        @unique
  email          String?       @unique
  keycloakUserId String?       @unique @map("keycloak_user_id")
  status         AccountStatus @default(pending)
  /// 内置的第一个平台账号：不能停用、不能改角色
  isBuiltin      Boolean       @default(false) @map("is_builtin")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  roles PlatformAccountRole[]

  @@map("platform_account")
}

model PlatformRole {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String    @unique
  name      String
  /// super = 内置"平台超级管理员"：自动拥有平台入口下全部操作权限，不可改删
  kind      String    @default("custom")
  sort      Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  accounts PlatformAccountRole[]
  menus    PlatformRoleMenu[]

  @@map("platform_role")
}

model PlatformAccountRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  account PlatformAccount @relation(fields: [accountId], references: [id])
  role    PlatformRole    @relation(fields: [roleId], references: [id])

  @@unique([accountId, roleId])
  @@map("platform_account_role")
}

model PlatformRoleMenu {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId String @map("role_id") @db.Uuid
  menuId String @map("menu_id") @db.Uuid

  role PlatformRole @relation(fields: [roleId], references: [id])
  menu Menu         @relation(fields: [menuId], references: [id])

  @@unique([roleId, menuId])
  @@map("platform_role_menu")
}

/// 平台操作日志：开通租户、改状态、改功能授权、平台账号与角色变更、任务执行
model PlatformAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  detail         Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("platform_audit_log")
}

/// 定时任务：任务名只能取自代码里的注册表（白名单），这里只存调度设置和最近一次结果
model ScheduledJob {
  code        String    @id
  cron        String
  enabled     Boolean   @default(false)
  lastRunAt   DateTime? @map("last_run_at")
  lastStatus  String?   @map("last_status")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("scheduled_job")
}

model JobRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobCode    String    @map("job_code")
  trigger    String
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  status     String
  message    String?

  @@index([jobCode, startedAt])
  @@map("job_run")
}

// ---------------------------------------------------------------------------
// B4：字典、参数、操作日志
// ---------------------------------------------------------------------------

/// 字典类型。tenant_id 为空 = 平台提供（租户只读）；租户可以建自己的类型。
model DictType {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  code      String
  name      String
  /// 翻译键（界面按语言取文字）；租户自建的直接存名称
  nameKey   String?   @map("name_key")
  status    Boolean   @default(true)
  remark    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant?    @relation(fields: [tenantId], references: [id])
  items  DictItem[]

  @@unique([tenantId, code])
  @@map("dict_type")
}

model DictItem {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  typeId    String    @map("type_id") @db.Uuid
  value     String
  label     String
  labelKey  String?   @map("label_key")
  sort      Int       @default(0)
  status    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant?  @relation(fields: [tenantId], references: [id])
  type   DictType @relation(fields: [typeId], references: [id])

  @@unique([typeId, value])
  @@map("dict_item")
}

/// 参数。平台提供的只读；租户可以建自己的。
model SysParam {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  key       String
  value     String
  name      String
  nameKey   String?   @map("name_key")
  remark    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("sys_param")
}

/// 操作日志：谁、对哪个接口、做了什么（请求参数脱敏，不记返回内容）。参数保留 180 天，之后清空参数、保留其余。
model OperationLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  accountId  String?  @map("account_id") @db.Uuid
  username   String?
  method     String
  path       String
  status     Int
  durationMs Int      @map("duration_ms")
  ip         String?
  params     Json?
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("operation_log")
}

// ---------------------------------------------------------------------------
// B6：教学（学期、专业、课程、班级、选课、课件）
// ---------------------------------------------------------------------------

/// 学期：租户级，各校区共用
model Term {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  code             String
  name             String
  startDate        DateTime   @map("start_date") @db.Date
  endDate          DateTime   @map("end_date") @db.Date
  enrollOpenDate   DateTime?  @map("enroll_open_date") @db.Date
  enrollCloseDate  DateTime?  @map("enroll_close_date") @db.Date
  /// 退课截止日：之前退课记录作废，之后记 W
  dropDeadline     DateTime?  @map("drop_deadline") @db.Date
  status           TermStatus @default(planned)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at")
  createdBy        String?    @map("created_by") @db.Uuid
  updatedBy        String?    @map("updated_by") @db.Uuid
  deletedAt        DateTime?  @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  sections Section[]

  @@unique([tenantId, code])
  @@map("term")
}

model Major {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  code               String
  name               String
  degreeType         String?   @map("degree_type")
  deptId             String?   @map("dept_id") @db.Uuid
  totalCredits       Decimal   @default(0) @map("total_credits") @db.Decimal(6, 1)
  electiveMinCredits Decimal   @default(0) @map("elective_min_credits") @db.Decimal(6, 1)
  description        String?
  status             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  deletedAt          DateTime? @map("deleted_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  courses MajorCourse[]
  students StudentMajor[]

  @@unique([tenantId, code])
  @@map("major")
}

/// 课程：目录条目，不属于任何学期。有历史班级后编号和学分只读。
model Course {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  credits   Decimal   @default(0) @db.Decimal(4, 1)
  deptId    String?   @map("dept_id") @db.Uuid
  syllabus  String?
  status    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  prerequisites CoursePrerequisite[] @relation("CourseOf")
  requiredBy    CoursePrerequisite[] @relation("CoursePrereq")
  majors        MajorCourse[]
  sections      Section[]

  @@unique([tenantId, code])
  @@map("course")
}

model CoursePrerequisite {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  courseId       String @map("course_id") @db.Uuid
  prerequisiteId String @map("prerequisite_id") @db.Uuid

  course       Course @relation("CourseOf", fields: [courseId], references: [id])
  prerequisite Course @relation("CoursePrereq", fields: [prerequisiteId], references: [id])

  @@unique([courseId, prerequisiteId])
  @@map("course_prerequisite")
}

/// 课程设置：专业 ↔ 课程。类别是关系的属性（同一门课对 A 专业必修、对 B 专业选修）。
model MajorCourse {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  majorId       String  @map("major_id") @db.Uuid
  courseId      String  @map("course_id") @db.Uuid
  /// required / elective / general
  category      String
  suggestedTerm Int?    @map("suggested_term")
  note          String?

  major  Major  @relation(fields: [majorId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([majorId, courseId])
  @@map("major_course")
}

/// 学生 ↔ 专业申报
model StudentMajor {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  personId   String   @map("person_id") @db.Uuid
  majorId    String   @map("major_id") @db.Uuid
  /// primary / minor
  kind       String   @default("primary")
  declaredOn DateTime @default(dbgenerated("CURRENT_DATE")) @map("declared_on") @db.Date
  active     Boolean  @default(true)

  major Major @relation(fields: [majorId], references: [id])

  @@unique([personId, majorId])
  @@index([tenantId, personId])
  @@map("student_major")
}

/// 班级：某课程在某学期、某校区的一次开课
model Section {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  courseId  String        @map("course_id") @db.Uuid
  termId    String        @map("term_id") @db.Uuid
  campusId  String        @map("campus_id") @db.Uuid
  number    String
  name      String
  capacity  Int
  /// onsite / online / hybrid
  mode      String        @default("onsite")
  /// 上课安排：[{weekday: 1-7, start: "HH:MM", end: "HH:MM", room?: string}]，时间是校区当地时间
  schedule  Json          @default("[]")
  status    SectionStatus @default(draft)
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")
  createdBy String?       @map("created_by") @db.Uuid
  updatedBy String?       @map("updated_by") @db.Uuid

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  course      Course              @relation(fields: [courseId], references: [id])
  term        Term                @relation(fields: [termId], references: [id])
  campus      Campus              @relation(fields: [campusId], references: [id])
  instructors SectionInstructor[]
  enrollments Enrollment[]
  materials   SectionMaterial[]
  groups      AssignmentGroup[]
  assignments Assignment[]

  @@unique([courseId, termId, number])
  @@index([tenantId, campusId])
  @@map("section")
}

model SectionInstructor {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  sectionId String @map("section_id") @db.Uuid
  personId  String @map("person_id") @db.Uuid
  /// lead / assistant
  role      String @default("lead")

  section Section @relation(fields: [sectionId], references: [id])

  @@unique([sectionId, personId])
  @@index([tenantId, personId])
  @@map("section_instructor")
}

/// 选课：学生 ↔ 班级
model Enrollment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  sectionId        String           @map("section_id") @db.Uuid
  studentPersonId  String           @map("student_person_id") @db.Uuid
  status           EnrollmentStatus @default(enrolled)
  /// self / registrar
  method           String           @default("self")
  /// 教务代选或特批时的原因
  reason           String?
  /// 教务代选时确认过的情形：["capacity", "prerequisite", "conflict", "window"]
  overrides        Json             @default("[]")
  enrolledAt       DateTime         @default(now()) @map("enrolled_at")
  droppedAt        DateTime?        @map("dropped_at")
  /// 课程是否通过（由成绩模块 B8 写入；先修课校验只认 true）
  passed           Boolean?
  createdBy        String?          @map("created_by") @db.Uuid

  section Section @relation(fields: [sectionId], references: [id])

  @@index([tenantId, studentPersonId])
  @@index([sectionId])
  @@map("enrollment")
}

/// 班级课件：任课教师增删改，选课学生可看（第一版只存标题和外链，文件上传在文档库里程碑）
model SectionMaterial {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  title     String
  /// slides / reference / syllabus
  category  String   @default("slides")
  url       String
  sort      Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  section Section @relation(fields: [sectionId], references: [id])

  @@index([sectionId])
  @@map("section_material")
}

/// 事件（出站箱）：选课作废、班级取消等要通知的事先写在这里，B9 的通知服务消费
model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  /// 重试多次仍失败：不再自动处理，留着排查
  failedAt    DateTime? @map("failed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, processedAt])
  @@map("outbox_event")
}

/// 作业分组（成绩构成里的一组，如"作业""期中"）；权重在成绩模块（B8）里加
model AssignmentGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  name      String
  sort      Int      @default(0)
  /// 权重（百分点）；班级所有分组的权重合计必须是 100 才能算总评
  weight    Decimal  @default(0) @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")

  section     Section      @relation(fields: [sectionId], references: [id])
  assignments Assignment[]

  @@unique([sectionId, name])
  @@map("assignment_group")
}

/// 作业：属于班级；截止是截止日 23:59（含），按班级所属校区的时区，dueAt 是换算好的时刻
model Assignment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  sectionId   String    @map("section_id") @db.Uuid
  groupId     String?   @map("group_id") @db.Uuid
  title       String
  description String    @default("")
  /// 附件（外链）：[{title, url}]
  attachments Json      @default("[]")
  dueDate     DateTime  @map("due_date") @db.Date
  dueAt       DateTime  @map("due_at")
  allowLate   Boolean   @default(true) @map("allow_late")
  /// 迟交扣分表：{tiers: [{upToHours, pct}], beyondPct}
  latePolicy  Json      @map("late_policy")
  /// 满分 = 评分标准各项之和（改评分标准时重算）
  maxScore    Decimal   @default(0) @map("max_score") @db.Decimal(7, 2)
  /// 只能手工录分（期中、期末、课堂参与）：学生不提交
  manualOnly  Boolean   @default(false) @map("manual_only")
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by") @db.Uuid

  section     Section               @relation(fields: [sectionId], references: [id])
  group       AssignmentGroup?      @relation(fields: [groupId], references: [id])
  rubric      RubricItem[]
  extensions  AssignmentExtension[]
  submissions Submission[]

  @@index([sectionId])
  @@map("assignment")
}

/// 评分标准的一项
model RubricItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  assignmentId String  @map("assignment_id") @db.Uuid
  title        String
  description  String?
  maxPoints    Decimal @map("max_points") @db.Decimal(6, 2)
  sort         Int     @default(0)

  assignment Assignment        @relation(fields: [assignmentId], references: [id])
  scores     SubmissionScore[]

  @@index([assignmentId])
  @@map("rubric_item")
}

/// 延期：给某个学生的某次作业多几天（最多 3 天）
model AssignmentExtension {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  assignmentId    String   @map("assignment_id") @db.Uuid
  studentPersonId String   @map("student_person_id") @db.Uuid
  days            Int
  reason          String
  grantedBy       String   @map("granted_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, studentPersonId])
  @@map("assignment_extension")
}

/// 提交：一个学生对一次作业只有一条，重新提交加新版本，以最后一次为准
model Submission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  assignmentId    String           @map("assignment_id") @db.Uuid
  studentPersonId String           @map("student_person_id") @db.Uuid
  status          SubmissionStatus @default(submitted)
  currentVersion  Int              @default(1) @map("current_version")
  /// 最后一次提交的时间（以服务器收到为准）
  submittedAt     DateTime         @map("submitted_at")
  isLate          Boolean          @default(false) @map("is_late")
  hoursLate       Decimal          @default(0) @map("hours_late") @db.Decimal(8, 2)
  rawScore        Decimal?         @map("raw_score") @db.Decimal(7, 2)
  latePenaltyPct  Int?             @map("late_penalty_pct")
  finalScore      Decimal?         @map("final_score") @db.Decimal(7, 2)
  feedback        String?
  gradedBy        String?          @map("graded_by") @db.Uuid
  gradedAt        DateTime?        @map("graded_at")
  publishedAt     DateTime?        @map("published_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  assignment Assignment          @relation(fields: [assignmentId], references: [id])
  versions   SubmissionVersion[]
  scores     SubmissionScore[]

  @@unique([assignmentId, studentPersonId])
  @@index([tenantId, studentPersonId])
  @@map("submission")
}

model SubmissionVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  version      Int
  textAnswer   String?  @map("text_answer")
  submittedAt  DateTime @map("submitted_at")
  isLate       Boolean  @default(false) @map("is_late")

  submission Submission       @relation(fields: [submissionId], references: [id])
  files      SubmissionFile[]

  @@unique([submissionId, version])
  @@map("submission_version")
}

/// 提交的文件：先拿预签名地址上传（versionId 为空），提交时确认并挂到新版本
model SubmissionFile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  assignmentId    String   @map("assignment_id") @db.Uuid
  studentPersonId String   @map("student_person_id") @db.Uuid
  versionId       String?  @map("version_id") @db.Uuid
  /// 对象存储键，以 tenant/<租户id>/ 开头
  storageKey      String   @unique @map("storage_key")
  fileName        String   @map("file_name")
  contentType     String   @map("content_type")
  size            Int
  createdAt       DateTime @default(now()) @map("created_at")

  version SubmissionVersion? @relation(fields: [versionId], references: [id])

  @@index([assignmentId, studentPersonId])
  @@map("submission_file")
}

/// 评分标准逐项打分
model SubmissionScore {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  submissionId String  @map("submission_id") @db.Uuid
  rubricItemId String  @map("rubric_item_id") @db.Uuid
  points       Decimal @db.Decimal(6, 2)
  comment      String?

  submission Submission @relation(fields: [submissionId], references: [id])
  rubricItem RubricItem @relation(fields: [rubricItemId], references: [id])

  @@unique([submissionId, rubricItemId])
  @@map("submission_score")
}

/// 成绩等级表（租户级；没有记录时用默认表）。passing 为真的是及格档
model GradingScaleItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  grade      String
  minPercent Decimal @map("min_percent") @db.Decimal(5, 1)
  points     Decimal @db.Decimal(3, 1)
  passing    Boolean

  @@unique([tenantId, grade])
  @@map("grading_scale_item")
}

/// 手工录入的单次成绩（没有提交的作业，如期中、期末、参与）
model ManualGrade {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  assignmentId    String   @map("assignment_id") @db.Uuid
  studentPersonId String   @map("student_person_id") @db.Uuid
  points          Decimal  @db.Decimal(7, 2)
  enteredBy       String?  @map("entered_by") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([assignmentId, studentPersonId])
  @@map("manual_grade")
}

/// 最终成绩（每条选课一条）。publishedAt 为空 = 草稿，学生看不到
model FinalGrade {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  enrollmentId String    @unique @map("enrollment_id") @db.Uuid
  total        Decimal   @db.Decimal(5, 1)
  grade        String
  gradePoints  Decimal   @map("grade_points") @db.Decimal(3, 1)
  passed       Boolean
  /// 各分组的得分率和权重，留作依据
  breakdown    Json      @default("[]")
  computedBy   String?   @map("computed_by") @db.Uuid
  computedAt   DateTime  @default(now()) @map("computed_at")
  publishedAt  DateTime? @map("published_at")

  @@map("final_grade")
}

/// 最终成绩的改动记录：改前、改后、原因、谁改的（发布后的改动不静默）
model GradeChange {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  kind         String
  before       Json?
  after        Json
  reason       String?
  changedBy    String?  @map("changed_by") @db.Uuid
  changedAt    DateTime @default(now()) @map("changed_at")

  @@index([enrollmentId])
  @@map("grade_change")
}

/// 成绩单生成记录：每份有唯一文档编号
model TranscriptIssue {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  studentPersonId String   @map("student_person_id") @db.Uuid
  docNumber       String   @map("doc_number")
  /// informal / formal
  version         String
  generatedBy     String?  @map("generated_by") @db.Uuid
  generatedAt     DateTime @default(now()) @map("generated_at")

  @@unique([tenantId, docNumber])
  @@index([tenantId, studentPersonId])
  @@map("transcript_issue")
}

/// 站内消息（也是邮件的发送队列）。dedupeKey 保证同一个事件对同一个人只生成一条
model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  category      String
  /// 模板类型：消息文字按收件人的语言在读取时渲染；公告是自由文字（type = announcement）
  type          String
  params        Json      @default("{}")
  title         String?
  body          String?
  /// 为假：用户关掉了站内消息，只为邮件排队和去重而存在，不在消息中心出现
  inApp         Boolean   @default(true) @map("in_app")
  dedupeKey     String    @map("dedupe_key")
  /// none / pending / sent / failed
  emailStatus   String    @default("none") @map("email_status")
  emailAttempts Int       @default(0) @map("email_attempts")
  createdAt     DateTime  @default(now()) @map("created_at")
  readAt        DateTime? @map("read_at")

  @@unique([accountId, dedupeKey])
  @@index([accountId, createdAt])
  @@map("notification")
}

/// 用户按类别关闭站内消息或邮件（没有记录 = 都开）
model NotificationPreference {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  category  String
  inApp     Boolean @default(true) @map("in_app")
  email     Boolean @default(true)

  @@unique([accountId, category])
  @@map("notification_preference")
}

/// 租户公告：面向全公司、一个校区或一个班级；阅读名单就是它生成的那批消息的已读情况
model Announcement {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String
  body        String
  /// tenant / campus / section
  scopeKind   String    @map("scope_kind")
  campusId    String?   @map("campus_id") @db.Uuid
  sectionId   String?   @map("section_id") @db.Uuid
  recipients  Int       @default(0)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  @@index([tenantId, createdAt])
  @@map("announcement")
}

/// 平台公告（横幅）：平台表，没有 tenant_id，租户的数据库账号碰不到；租户用户经接口读取当前有效的
model PlatformAnnouncement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  body      String
  /// info / warning
  severity  String   @default("info")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([startsAt, endsAt])
  @@map("platform_announcement")
}

/// 班级讨论：帖子（有标题）和回复（parentId 指向帖子）。删除是软删除；回复不能再有回复
model DiscussionPost {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  sectionId      String    @map("section_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  authorPersonId String    @map("author_person_id") @db.Uuid
  title          String?
  body           String
  pinned         Boolean   @default(false)
  resolved       Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  @@index([sectionId, createdAt])
  @@index([parentId])
  @@map("discussion_post")
}

/// 文档库文件夹（树）。ancestors 含自己，由触发器维护；"子树" = ancestors @> ARRAY[文件夹id]
model DocFolder {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  ancestors      String[] @default([])
  name           String
  /// 所属部门：只用来生成默认授权
  ownerDeptId    String?  @map("owner_dept_id") @db.Uuid
  /// public / internal / confidential
  classification String   @default("internal")
  /// 为真：这个文件夹的有效授权 = 自己的授权 + 上级的有效授权；机密文件夹建立时断开
  inheritAcl     Boolean  @default(true) @map("inherit_acl")
  /// 仅在线预览（不能下载）；只对机密文件夹有意义
  previewOnly    Boolean  @default(false) @map("preview_only")
  /// 记录访问日志；机密文件夹必记，内部文件夹可选
  logAccess      Boolean  @default(false) @map("log_access")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([tenantId, parentId])
  @@index([ancestors], type: Gin)
  @@map("doc_folder")
}

/// 文件夹访问授权：没有"拒绝"，多条取最高级别
model DocAcl {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  folderId      String    @map("folder_id") @db.Uuid
  /// everyone（含学生）/ all_staff（全体员工）/ dept / role / user
  principalType String    @map("principal_type")
  principalId   String?   @map("principal_id") @db.Uuid
  includeSub    Boolean   @default(false) @map("include_sub")
  /// view（查看/下载）/ edit（编辑/上传）/ manage（管理）
  level         String
  /// default（建文件夹时按规则生成）/ manual
  source        String    @default("manual")
  expiresAt     DateTime? @map("expires_at")
  grantedBy     String?   @map("granted_by") @db.Uuid
  grantedAt     DateTime  @default(now()) @map("granted_at")

  @@index([tenantId, folderId])
  @@map("doc_acl")
}

/// 文件：当前版本的信息在这一行，历史版本在 doc_file_version
model DocFile {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  folderId    String    @map("folder_id") @db.Uuid
  name        String
  storageKey  String    @map("storage_key")
  size        Int
  contentType String    @map("content_type")
  version     Int       @default(1)
  uploadedBy  String?   @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([tenantId, folderId])
  @@map("doc_file")
}

model DocFileVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  fileId      String   @map("file_id") @db.Uuid
  version     Int
  storageKey  String   @unique @map("storage_key")
  size        Int
  contentType String   @map("content_type")
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  @@unique([fileId, version])
  @@map("doc_file_version")
}

/// 已登记、等浏览器直传的上传（预签名地址发出去了，还没确认）
model DocUpload {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  folderId    String   @map("folder_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  /// 不为空 = 给这个文件上传新版本
  fileId      String?  @map("file_id") @db.Uuid
  storageKey  String   @unique @map("storage_key")
  name        String
  size        Int
  contentType String   @map("content_type")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("doc_upload")
}

/// 访问日志：谁、何时、对哪个文件/文件夹、做了什么
model DocAccessLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  accountId String?  @map("account_id") @db.Uuid
  action    String
  folderId  String?  @map("folder_id") @db.Uuid
  fileId    String?  @map("file_id") @db.Uuid
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, folderId, createdAt])
  @@map("doc_access_log")
}
