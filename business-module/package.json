{
  "name": "staredu-business-module",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter @staredu/api prisma:generate",
    "migrate": "pnpm --filter @staredu/api prisma:migrate",
    "dev:api": "pnpm --filter @staredu/api dev",
    "dev:web": "pnpm --filter @staredu/web dev",
    "realm": "tsx scripts/create-realm.ts",
    "smoke": "tsx scripts/smoke-b0.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@prisma/client": "^6.19.3",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0"
  }
}
