# 业务模块本地开发默认值（仅用于本机演示；对外开放前必须全部修改）。
# 复制为 .env 后可覆盖。AI 模块的服务占用 5432/6379/9000/9001/8080，所以这里全部错开。

# --- 应用 ---
API_PORT=4000
WEB_PORT=3001
# 应用用低权限账号 biz_app 连库（受行级安全约束）；迁移和开通租户脚本用库所有者账号。
# biz_app 由迁移创建，默认密码仅供本地，上线前必须 ALTER ROLE 修改。
DATABASE_URL=postgresql://biz_app:starit-app@localhost:5433/starit_biz?schema=biz
MIGRATION_DATABASE_URL=postgresql://starit:starit@localhost:5433/starit_biz?schema=biz
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY=starit
S3_SECRET_KEY=starit-secret
S3_BUCKET=starit-biz
# Address the browser uses to upload and download files (presigned URLs). Defaults to S3_ENDPOINT_URL;
# set it when the browser reaches the object store under a different name than the server does.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
# Largest file a student can submit, in bytes (default 20 MB).
# UPLOAD_MAX_BYTES=20971520
# Transcript PDFs use the Noto Sans SC subset in apps/api/assets/fonts (3,755 common hanzi). To use another font, point this at a TTF/OTF file.
# TRANSCRIPT_FONT_PATH=/path/to/font.ttf

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- 邮件（Mailpit：只接收，不真发；真实 SMTP 只改这几项）---
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_FROM=no-reply@staredu.test
MAILPIT_API_URL=http://localhost:8125
# Real SMTP: set these; business e-mail and the Keycloak realm template (new tenants) both read them.
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=none   # none | ssl | starttls

# --- Event bus ---
# outbox (default): events in the outbox table are handled inside the API process. No extra service is needed.
# kafka: events are relayed to Kafka and handled by consumer groups. Start it with `make biz-up-kafka`.
# BIZ_EVENT_BUS=outbox
# KAFKA_BROKERS=localhost:9094
# KAFKA_TOPIC_PREFIX=          # e.g. "dev." to share one broker between environments
# KAFKA_GROUP_PREFIX=staredu   # consumer group names are <prefix>.notifications, ...
# KAFKA_PARTITIONS=3
# BIZ_KAFKA_PORT=9094
# KAFKA_HEAP_OPTS=-Xms256m -Xmx512m

# --- Notifications ---
# How often the worker looks for new events and queued e-mail, in milliseconds (set NOTIFY_WORKER=off to disable it).
# NOTIFY_POLL_MS=2000
# Signs unsubscribe links. Required in production.
# NOTIFY_SECRET=change-me-to-a-long-random-string
# Where unsubscribe links point; {code} is the tenant code.
# PUBLIC_API_URL=http://{code}.localhost:4000

# --- docker compose 端口与账号（deploy/compose/biz.yaml 使用）---
POSTGRES_USER=starit
POSTGRES_PASSWORD=starit
POSTGRES_DB=starit_biz
BIZ_PG_PORT=5433
BIZ_REDIS_PORT=6380
BIZ_S3_PORT=9100
BIZ_S3_CONSOLE_PORT=9101
BIZ_KEYCLOAK_PORT=8180
BIZ_MAILPIT_SMTP_PORT=1125
BIZ_MAILPIT_UI_PORT=8125
MINIO_ROOT_USER=starit
MINIO_ROOT_PASSWORD=starit-secret

# --- Web app (server side only) ---
# Signs the short-lived sign-in cookie. A development default is used when unset; required in production.
# WEB_SESSION_SECRET=change-me-to-a-long-random-string
# API_URL=http://localhost:4000
# Address the browser uses to reach Keycloak, if different from KEYCLOAK_URL
# KEYCLOAK_PUBLIC_URL=http://localhost:8180
