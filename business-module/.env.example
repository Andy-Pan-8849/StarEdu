# 业务模块本地开发默认值（仅用于本机演示；对外开放前必须全部修改）。
# 复制为 .env 后可覆盖。AI 模块的服务占用 5432/6379/9000/9001/8080，所以这里全部错开。

# --- 应用 ---
API_PORT=4000
WEB_PORT=3001
DATABASE_URL=postgresql://starit:starit@localhost:5433/starit_biz?schema=biz
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY=starit
S3_SECRET_KEY=starit-secret
S3_BUCKET=starit-biz

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- 邮件（Mailpit：只接收，不真发；真实 SMTP 只改这几项）---
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_FROM=no-reply@staredu.test
MAILPIT_API_URL=http://localhost:8125

# --- docker compose 端口与账号（deploy/compose/biz.yaml 使用）---
POSTGRES_USER=starit
POSTGRES_PASSWORD=starit
POSTGRES_DB=starit_biz
BIZ_PG_PORT=5433
BIZ_REDIS_PORT=6380
BIZ_S3_PORT=9100
BIZ_S3_CONSOLE_PORT=9101
BIZ_KEYCLOAK_PORT=8180
BIZ_MAILPIT_SMTP_PORT=1125
BIZ_MAILPIT_UI_PORT=8125
MINIO_ROOT_USER=starit
MINIO_ROOT_PASSWORD=starit-secret
