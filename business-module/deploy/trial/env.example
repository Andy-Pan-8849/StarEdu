# Extra settings for a public trial host (on top of the normal .env).

# Turn the protection on (demo companies on tenant hosts; the whole platform host).
TRIAL_PROTECT=1

# A trial host builds demo data on purpose; a real deployment never sets this.
ALLOW_DEMO_SEED=1

# Notice shown above every page (read at run time by the web app).
TRIAL_BANNER="Public trial: some actions are turned off. Data is reset every day at 03:00 UTC."

# Keep uploads small (bytes): assignment files 2 MB, document library 5 MB.
UPLOAD_MAX_BYTES=2097152
LIBRARY_MAX_BYTES=5242880
